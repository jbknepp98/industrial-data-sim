.env
.env.*
!.env.example
.DS_Store

# Local credentials, certificates, and deployment artifacts
certs/
secrets/
*.pem
*.cer
*.crt
*.key
*.pfx
*.p12
*.jks
*.keystore
*.log
logs/
screenshots/
dumps/

# Build tooling, generated output, and runtime state
.tools/
**/bin/
**/obj/
TestResults/
state/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Python verification caches
__pycache__/
*.pyc

# Durable-runtime ownership handles
*.db.owner
*.sqlite.owner

# Runtime operational diagnostics (also when a host chooses another directory)
runtime.jsonl
runtime.[0-9]*.jsonl
runtime.log.owner
