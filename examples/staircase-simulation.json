{
  "schemaVersion": 1,
  "generatorVersion": 1,
  "session": {
    "schemaVersion": 1,
    "sessionId": "example-staircase-session",
    "connectionProfile": "local-development",
    "dataset": "Example Dataset",
    "startUtc": "2026-09-01T00:00:00Z",
    "endUtc": "2026-09-01T00:00:08Z",
    "outputTags": [
      {
        "name": "Example.Temperature",
        "valueType": "number"
      },
      {
        "name": "Example.Running",
        "valueType": "boolean"
      },
      {
        "name": "Example.State",
        "valueType": "string"
      }
    ]
  },
  "samplingIntervalMs": 1000,
  "generators": [
    {
      "tag": "Example.Temperature",
      "kind": "staircase",
      "afterSteps": "holdLast",
      "steps": [
        {
          "value": 0,
          "durationMs": 2000
        },
        {
          "value": 10,
          "durationMs": 3000
        },
        {
          "value": 20,
          "durationMs": 1000
        }
      ]
    },
    {
      "tag": "Example.Running",
      "kind": "constant",
      "value": true
    },
    {
      "tag": "Example.State",
      "kind": "constant",
      "value": "Idle"
    }
  ]
}
