  "storylines": [
    {
      "id": "labeler-jams-late-orders",
      "title": "Labeler jams make orders late",
      "pitch": "A labeler keeps jamming, orders ship late, and nobody connects the maintenance ticket to the line slowing down.",
      "industries": [
        "food-beverage",
        "cpg"
      ],
      "roles": [
        "plant-manager",
        "maintenance",
        "ci-oee"
      ],
      "kpis": [
        "OEE availability",
        "on-time delivery",
        "MTTR"
      ],
      "evidence": 12,
      "systems": [
        "SAP PM or a CMMS for work orders",
        "ERP sales orders",
        "Ignition line tags"
      ],
      "engine": "available",
      "requires": [
        "shipping"
      ],
      "closest": null,
      "base": "beverage-2-line",
      "fragment": {
        "demand": {
          "dueDays": {
            "minimum": 1.5,
            "maximum": 2.5
          }
        },
        "incidents": [
          {
            "failureMode": "LB202-JAM",
            "at": "-30h",
            "note": "Storyline: the jam the demo walks through; vibration climbs for 8 hours first."
          },
          {
            "failureMode": "LB202-JAM",
            "at": "-3d",
            "note": "Storyline: an earlier jam on the same labeler."
          }
        ]
      },
      "talkTrack": [
        {
          "tool": "Explorer",
          "tags": [
            "{TagRoot}.L1.LB-202.Vibration",
            "{TagRoot}.L1.Speed",
            "{TagRoot}.L1.State"
          ],
          "tables": [],
          "ask": "Trend labeler vibration with line speed and state over the last two days.",
          "expect": "Vibration climbs for hours, then the line drops to Down while speed goes to zero."
        },
        {
          "tool": "Connect",
          "tags": [],
          "tables": [
            "{prefix}downtimeevents",
            "{prefix}maintenancetickets"
          ],
          "ask": "Show the downtime event and the maintenance ticket for that stop.",
          "expect": "The ticket opened five minutes after the stop, with the technician and repair time."
        },
        {
          "tool": "Connect",
          "tags": [],
          "tables": [
            "{prefix}salesorders",
            "{prefix}shipments"
          ],
          "ask": "Which sales orders shipped late this week?",
          "expect": "The late orders were in production on Line 1 when the labeler jammed."
        },
        {
          "tool": "Gage",
          "tags": [],
          "tables": [],
          "ask": "Why were orders late this week, and what should maintenance do about Labeler 202?",
          "expect": "An answer that joins the jams, the tickets and the late orders, and points to the worn gripper pads."
        }
      ]
    },
