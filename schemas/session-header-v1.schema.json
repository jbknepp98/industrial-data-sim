{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Industrial Data Simulator session header v1",
  "description": "Offline header contract, not an executable simulation. Runtime validation also checks chronological ordering and case-insensitive output-tag uniqueness. Credentials belong in separate local profiles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "connectionProfile",
    "dataset",
    "startUtc",
    "endUtc",
    "outputTags"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "sessionId": {
      "$ref": "#/$defs/identifier"
    },
    "connectionProfile": {
      "$ref": "#/$defs/identifier"
    },
    "dataset": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-](?:[A-Za-z0-9_ -]*[A-Za-z0-9_-])?$",
      "not": {
        "pattern": "[^A-Za-z0-9_ -]"
      }
    },
    "startUtc": {
      "$ref": "#/$defs/utc"
    },
    "endUtc": {
      "$ref": "#/$defs/utc"
    },
    "outputTags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "valueType"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "^[\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]|[\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]$|[\\u0000-\\u001F\\u007F-\\u009F]"
            }
          },
          "valueType": {
            "enum": [
              "number",
              "boolean",
              "string"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$",
      "not": {
        "pattern": "[^0-9TZ:.\\-]"
      }
    }
  }
}
