{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Industrial Data Simulator session header v1",
  "description": "Offline header contract, not an executable simulation. Runtime validation also checks chronological ordering and case-insensitive output-tag uniqueness. Credentials belong in separate local profiles. schemaVersion 2 (1.1.0) adds backfill as an alternative to startUtc and makes endUtc optional: without it the session is open-ended and runs until stopped.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "connectionProfile",
    "dataset",
    "outputTags"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "sessionId": {
      "$ref": "#/$defs/identifier"
    },
    "connectionProfile": {
      "$ref": "#/$defs/identifier"
    },
    "dataset": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-](?:[A-Za-z0-9_ -]*[A-Za-z0-9_-])?$",
      "not": {
        "pattern": "[^A-Za-z0-9_ -]"
      }
    },
    "startUtc": {
      "$ref": "#/$defs/utc"
    },
    "backfill": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,7}(s|m|h|d)$",
      "description": "schemaVersion 2 only: relative backfill (for example 72h) resolved to startUtc by the CLI before admission; at most 3650 days."
    },
    "endUtc": {
      "$ref": "#/$defs/utc"
    },
    "outputTags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "valueType"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "^[\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]|[\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]$|[\\u0000-\\u001F\\u007F-\\u009F]"
            }
          },
          "valueType": {
            "enum": [
              "number",
              "boolean",
              "string"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$",
      "not": {
        "pattern": "[^0-9TZ:.\\-]"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "required": [
          "startUtc",
          "endUtc"
        ],
        "not": {
          "required": [
            "backfill"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "oneOf": [
          {
            "required": [
              "startUtc"
            ],
            "not": {
              "required": [
                "backfill"
              ]
            }
          },
          {
            "required": [
              "backfill"
            ],
            "not": {
              "required": [
                "startUtc"
              ]
            }
          }
        ]
      }
    }
  ]
}
