{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Constant simulation v1",
  "description": "An offline, constant-only executable model wrapping a session header. Runtime also checks generator coverage, exact tag/type matching, finite numeric values, and strict integer tokens. Preview limits are checked separately by dry-run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatorVersion",
    "session",
    "samplingIntervalMs",
    "generators"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "generatorVersion": {
      "type": "integer",
      "const": 1
    },
    "session": {
      "$ref": "session-header-v1.schema.json"
    },
    "samplingIntervalMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "generators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tag",
          "kind",
          "value"
        ],
        "properties": {
          "tag": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "const": "constant"
          },
          "value": {
            "type": [
              "number",
              "boolean",
              "string"
            ]
          }
        }
      }
    }
  }
}
