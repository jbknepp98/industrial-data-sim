# flow-data-simulator-web settings. Copy to web.env (chmod 600). Never commit it.
# Pulse client (Pulse → Clients). Allowed audiences must include Pulse and Historian.
TIMEBASE_PROFILE=local-development
TIMEBASE_PULSE_URL=https://pulse:4542
TIMEBASE_CLIENT_ID=DataSim
TIMEBASE_CLIENT_SECRET=<the client secret from Pulse>
TIMEBASE_AUDIENCE=Historian
TIMEBASE_CA_BUNDLE=/certs/pulse-root-ca.pem
# Historian that receives the plant tags. Each approved plant gets its own
# Dataset, named after the plant (365-day purge age), created on approval.
TIMEBASE_BASE_URL=https://historian:4512
# Optional: only plants approved with 2.0.0-rc.1 (before plants had their own
# Dataset) still write here. Leave it out on a new install.
#TIMEBASE_DATASET=Test
# flow_data_sim as flowsim_writer (the writer password from postgres.env).
FLOWSIM_PG_CONNECTION=Host=flow-data-sim-pg;Port=5432;Database=flow_data_sim;Username=flowsim_writer;Password=<writer password>
# Optional: the Gage model handle (Pulse → Gage → Models). Default anthropic/claude.
#FLOWSIM_GAGE_MODEL=anthropic/claude
# Optional: host names the page answers on (default localhost;127.0.0.1;[::1]).
#FLOWSIM_WEB_ALLOWED_HOSTS=localhost;127.0.0.1;[::1]
